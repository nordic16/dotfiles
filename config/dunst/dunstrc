[global]
    frame_color = "#7F7871"
    separator_color = "frame"
    frame_width = 2
    corner_radius = 10
    icon_path = "/usr/share/icons/Tela-circle-blue-light/16@2x/devices/"

[urgency_low]
    background = "#030305"
    foreground = "#FFC37E"
    timeout = 10

[urgency_normal]
    background = "#030305"
    foreground = "#FFC37E"
    frame_color = "#7F7871"
    timeout = 15

[urgency_high]
    background = "#030305"
    foreground = "#434858"
    frame_color = "#434858"
    timeout = 0
