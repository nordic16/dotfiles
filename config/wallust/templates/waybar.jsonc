// -*- mode: jsonc -*-
{
  "reload_style_on_change": true,
  "margin-top": 10,
  "width": 1895,
  "spacing": 10,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["bluetooth", "network"],
  "modules-right": ["clock", "pulseaudio/slider", "custom/power"],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "<span size='140%'>󰣇</span>",
      "2": "<span size='140%'>󰖟</span>",
      "3": "<span size='140%'>󰅬</span>",
      "4": "<span size='140%'></span>",
      "5": "<span size='140%'></span>",
      "urgent": "<span color='{{color1}}'>  </span>",
      "focused": "<span color='{{color6}}'>  </span>",
      "default": "  ",
    },
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%d-%m-%Y}",
  },

  "cpu": {
    "format": "<span color='{{color2}}' size='140%' rise='-2000'></span> {usage}%",
    "tooltip": false,
  },

  "memory": {
    "format": "<span color='{{color3}}' size='140%' rise='-2000'></span> {}%",
  },

  "network": {
    "format-wifi": "<span color='#8BC34A' size='140%'></span> {essid} ({signalStrength}%)",
    "format-ethernet": "<span color='#8BC34A' size='140%' rise='-2000'>󰖩</span>",
    "format-disconnected": "<span color='{{color1}}'>⚠</span>",
  },

  "pulseaudio": {
    "format": "<span color='{{color3}}' size='140%' rise='-2000'>{icon}</span> {value}%",
    "format-muted": "<span color='#F44336'></span> {format_source}",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
  },

  "bluetooth": {
    "format": "<span rise='-2000'></span>",
    "format-connected": "<span rise='-2000' color='#8BC34A'></span>",
    "format-connected-battery": "<span color='#F44336' rise='-2000'></span>",
  },

  "mpris": {
    "interval": 1,
    "dynamic-len": 35,
    "format": "<span color='{{color2}}' size='140%' rise='-2000'>{player_icon}</span> <b>{dynamic}</b>",
    "format-paused": "<span color='{{color8}}' size='140%' rise='-2000'>{status_icon}</span> <i>{dynamic}</i>",
    "player-icons": { "default": "▶", "mpv": "🎵" },
    "status-icons": { "paused": "⏸" },
  },

  "custom/power": {
    "format": "<span color='{{color7}}' size='140%'>⏼</span>",
    "on-click": "hyprshutdown",
  },

  "hyprland/window": {
    "format": "{}",
    "icon": true,
    "max-length": 35,
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },
}
