#!/usr/bin/env bash
set -euo pipefail

SCHEME="$HOME/.local/state/caelestia/scheme.json"
KITTY_THEME="$HOME/.config/kitty/colors.conf"

if [ ! -f "$SCHEME" ]; then
    echo "Esquema não encontrado em $SCHEME"
    exit 1
fi

# Mapeia as propriedades Material You para a sintaxe do Kitty
jq -r '
  "foreground " + .on_surface,
  "background " + .surface,
  "selection_foreground " + .on_secondary_container,
  "selection_background " + .secondary_container,
  "cursor " + .primary,
  "cursor_text_color " + .on_primary,

  # 0-7 (Normal)
  "color0 " + .surface_container_highest,
  "color1 " + .error,
  "color2 " + .primary,
  "color3 " + .tertiary,
  "color4 " + .secondary,
  "color5 " + .primary_container,
  "color6 " + .secondary_container,
  "color7 " + .on_surface_variant,

  # 8-15 (Bright)
  "color8 " + .outline,
  "color9 " + .error_container,
  "color10 " + .primary,
  "color11 " + .tertiary_container,
  "color12 " + .secondary,
  "color13 " + .inverse_primary,
  "color14 " + .surface_variant,
  "color15 " + .on_surface
' "$SCHEME" > "$KITTY_THEME"

# Atualiza janelas do Kitty ativas se o controlo remoto estiver ativo
kitty @ set-colors -a "$KITTY_THEME" 2>/dev/null || true
